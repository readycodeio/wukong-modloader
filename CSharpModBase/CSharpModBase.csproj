<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
        <AssemblyVersion>0.0.6.0</AssemblyVersion>
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="SharpDX" Version="4.2.0" />
        <PackageReference Include="SharpDX.XInput" Version="4.2.0" />
    </ItemGroup>

    <!--
        Game assemblies come from a reference-only NuGet package: API surface with no method
        bodies, resolved at compile time only. The real assemblies are already loaded in the
        game process at runtime, so nothing ships with the loader.
    -->
    <ItemGroup>
        <PackageReference Include="ReadyM.Wukong.GameRefs" Version="1.0.21.23831" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\HarmonyPrepatcher\src\Harmony\Lib.Harmony\Lib.Harmony.csproj" />
      <ProjectReference Include="..\ReadyM.Loader.Wukong.Bootstrap\ReadyM.Loader.Wukong.Bootstrap.csproj" />
    </ItemGroup>

</Project>
