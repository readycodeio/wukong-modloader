<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <DebugType>portable</DebugType>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <RootNamespace>ReadyM.Loader.Wukong.Managed</RootNamespace>
    </PropertyGroup>
    
    <Target Name="PrintBuildVersion" AfterTargets="AfterBuild">
        <Message Importance="High" Text="Build Version: $(InformationalVersion)" />
    </Target>

    <ItemGroup>
        <ProjectReference Include="..\CSharpModBase\CSharpModBase.csproj" />
        <ProjectReference Include="..\CSharpModBaseV2\CSharpModBaseV2.csproj" />
        <ProjectReference Include="..\ReadyM.Loader.Wukong.Bootstrap\ReadyM.Loader.Wukong.Bootstrap.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="ini-parser" Version="2.5.2" />
        <PackageReference Include="Mono.Cecil" Version="0.11.6" />
    </ItemGroup>

    <!--
        Game assemblies come from a reference-only NuGet package: API surface with no method
        bodies, resolved at compile time only. The real assemblies are already loaded in the
        game process at runtime, so nothing ships with the loader.
    -->
    <ItemGroup>
        <PackageReference Include="ReadyM.Wukong.GameRefs" Version="1.0.21.23831" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Logging\" />
    </ItemGroup>

</Project>
