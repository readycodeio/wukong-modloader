<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net472</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <AssemblyVersion>0.0.6.0</AssemblyVersion>
        <DebugType>portable</DebugType>
        <TargetExt>.bin</TargetExt>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    </PropertyGroup>

    <PropertyGroup>
        <BuildValue>$([System.DateTime]::op_Subtraction($([System.DateTime]::UtcNow), $([System.DateTime]::Parse('2024-12-17'))).Days)</BuildValue>
        <RevisionValue>$([System.DateTime]::UtcNow.ToString("HHmm"))</RevisionValue>
        <BuildTimestamp>$(BuildValue).$(RevisionValue)</BuildTimestamp>
        <FileVersion>0.7.$(BuildTimestamp)</FileVersion>
        <Version>0.7.$(BuildTimestamp)</Version>
        <InformationalVersion>0.7.$(BuildTimestamp)</InformationalVersion>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    </PropertyGroup>
    
    <Target Name="PrintBuildVersion" AfterTargets="AfterBuild">
        <Message Importance="High" Text="Build Version: $(InformationalVersion)" />
    </Target>

    <ItemGroup>
      <ProjectReference Include="..\CSharpModBase\CSharpModBase.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Mono.Cecil" Version="0.11.5" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="UnrealEngine">
            <HintPath>..\GameDll\UnrealEngine.dll</HintPath>
        </Reference>
        <Reference Include="UnrealEngine.Runtime">
            <HintPath>..\GameDll\UnrealEngine.Runtime.dll</HintPath>
        </Reference>
    </ItemGroup>

</Project>
